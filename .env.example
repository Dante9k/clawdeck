# At least 16 random characters. Use a unique password for this panel.
PANEL_PASSWORD=
PANEL_BIND=127.0.0.1
PANEL_PORT=3210
SERVER_NAME=
SERVER_ADDRESS=
# Set true behind HTTPS. Leave false for localhost + SSH tunnel.
COOKIE_SECURE=false
# Rootless Docker example: /run/user/1000/docker.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
